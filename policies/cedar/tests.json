[
  {
    "name": "P01 steward creates a reminder in its own user's collection with a direct instruction",
    "agtyle": {
      "id": "P01",
      "expected_outcome": "allow",
      "cedar_evaluable": true,
      "description": "Steward + reminder.create + direct instruction + same user scope"
    },
    "request": {
      "principal": "Agtyle::Agent::\"steward\"",
      "action": "Agtyle::Action::\"reminder.create\"",
      "resource": "Agtyle::ReminderCollection::\"user_local\"",
      "context": {
        "origin_user_id": "user_local",
        "has_direct_user_instruction": true,
        "payload_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "approval_present": false,
        "approval_valid": false
      }
    },
    "entities": [
