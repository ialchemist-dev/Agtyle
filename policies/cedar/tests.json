        "uid": {
          "type": "Agtyle::Agent",
          "id": "steward"
        },
        "attrs": {},
        "parents": []
      },
      {
        "uid": {
          "type": "Agtyle::ReminderCollection",
          "id": "user_local"
        },
        "attrs": {
          "owner": "user_local"
        },
        "parents": []
      },
      {
        "uid": {
          "type": "Agtyle::User",
          "id": "user_local"
        },
        "attrs": {},
        "parents": []
